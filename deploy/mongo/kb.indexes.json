{
  "collection": "kb_chunks",
  "indexes": [
    {
      "name": "sps_text_index",
      "type": "search",
      "definition": {
        "analyzers": [
          {
            "name": "sps_fr_folded",
            "tokenizer": {
              "type": "standard"
            },
            "tokenFilters": [
              {
                "type": "lowercase"
              },
              {
                "type": "asciiFolding"
              }
            ]
          }
        ],
        "mappings": {
          "dynamic": false,
          "fields": {
            "text": {
              "type": "string",
              "analyzer": "sps_fr_folded"
            },
            "country": {
              "type": "token"
            },
            "jurisdiction": {
              "type": "token"
            },
            "docType": {
              "type": "token"
            },
            "namespace": {
              "type": "token"
            },
            "isActive": {
              "type": "boolean"
            }
          }
        }
      }
    }
  ]
}
