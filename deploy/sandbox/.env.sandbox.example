# Locked-down sandbox — deployment variables (sovereign / open weights)
# Injected/confirmed with the Lab. Never commit real values.

# Local models (Ollama) — LLM + embeddings. No cloud provider.
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen3.5:9b
EMBEDDING_MODEL=bge-m3
# Enable the local TEI reranker or leave empty for RRF-only.
RERANK_URL=
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# Vector knowledge base (Qdrant). Leave QDRANT_URL unset to use the bundled
# service, or point it at a managed Qdrant instance provided by the Lab.
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=policy_chunks

# Object storage (MinIO) for assistant image attachments.
S3_ENDPOINT=http://minio:9000
S3_BUCKET=sps-attachments
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Operational store provided by the Lab (audit log + chain-of-thought only).
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER/?retryWrites=true&w=majority
MONGODB_DB_NAME=policy_sandbox

# Shared secret between the API and the Python services.
SERVICE_API_KEY=

# Image registry + tag used by the sandbox (set by CI/CD).
SPS_REGISTRY=<registry>/<namespace>
SPS_TAG=latest

# Public URL the web app uses to reach the API.
NEXT_PUBLIC_API_URL=https://api.policy-sandbox.example

API_PORT=8000
WEB_PORT=3000
