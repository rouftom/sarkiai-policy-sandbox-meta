{
  "name": "@sps/mcp-charts",
  "version": "1.2.1",
  "type": "module",
  "description": "Premium data visualization MCP App using Recharts",
  "license": "MIT",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc --noEmit && cross-env INPUT=src/mcp-app.html vite build && mv dist/src/mcp-app.html dist/mcp-app.html && rmdir dist/src && tsc -p tsconfig.server.json && bun build src/server.ts --outdir dist --target node && bun build src/main.ts --outfile dist/index.js --target node --banner \"#!/usr/bin/env node\"",
    "watch": "cross-env INPUT=src/mcp-app.html vite build --watch",
    "serve": "bun --watch src/main.ts",
    "start": "bun dist/index.js",
    "dev": "concurrently 'bun run watch' 'cross-env PORT=3000 bun --watch src/main.ts'",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "botid": "^1.5.12",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "framer-motion": "^12.43.0",
    "i18next": "^25.10.10",
    "i18next-browser-languagedetector": "^8.3.0",
    "i18next-resources-to-backend": "^1.2.4",
    "lucide-react": "^0.475.0",
    "mcp-handler": "^1.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^16.6.6",
    "recharts": "^2.15.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "concurrently": "^9.2.5",
    "cross-env": "^7.0.3",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "private": true
}
