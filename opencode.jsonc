{
  "$schema": "https://opencode.ai/config.json",
  // Project rules and skills live in .agent/ so the layout is not tied to a
  // single agent tool. The client reads that directory through this entry.
  "skills": [
    ".agent/skills"
  ],
  "mcp": {
    "servers": {
      "socket": {
        "type": "remote",
        "url": "https://mcp.socket.dev/"
      }
    }
  }
}
