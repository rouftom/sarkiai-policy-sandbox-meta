{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/sps/world/geometry-manifest.schema.json",
  "title": "GeometryManifest",
  "type": "object",
  "required": ["schemaVersion", "geoVersion", "viewBox", "projection", "borderPolicy", "chunks", "sources", "builtAt"],
  "additionalProperties": false,
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "chunkRef": {
      "type": "object",
      "required": ["url", "sha256", "bytes", "entities"],
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/hash" },
        "bytes": { "type": "integer", "minimum": 0 },
        "entities": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "properties": {
    "schemaVersion": { "const": 1 },
    "geoVersion": { "type": "string", "minLength": 1 },
    "viewBox": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 },
    "projection": { "type": "string" },
    "borderPolicy": { "enum": ["de-facto", "un-reference", "custom"] },
    "chunks": {
      "type": "object",
      "required": ["world", "adm1", "names", "adjacency"],
      "additionalProperties": false,
      "properties": {
        "world": {
          "type": "object", "required": ["L0", "L1"], "additionalProperties": false,
          "properties": { "L0": { "$ref": "#/$defs/chunkRef" }, "L1": { "$ref": "#/$defs/chunkRef" } }
        },
        "adm1": {
          "type": "object",
          "propertyNames": { "pattern": "^[A-Z]{2}$" },
          "additionalProperties": { "$ref": "#/$defs/chunkRef" }
        },
        "names": { "type": "object", "additionalProperties": { "$ref": "#/$defs/chunkRef" } },
        "adjacency": { "$ref": "#/$defs/chunkRef" },
        "groups": { "$ref": "#/$defs/chunkRef" }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "version", "licence", "url", "sha256"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" }, "version": { "type": "string" },
          "licence": { "type": "string" }, "url": { "type": "string" },
          "sha256": { "$ref": "#/$defs/hash" }
        }
      }
    },
    "builtAt": { "type": "string", "format": "date-time" }
  }
}
