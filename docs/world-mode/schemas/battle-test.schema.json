{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/sps/world/battle-test.schema.json",
  "title": "BattleTest",
  "description": "Stored battle test (collection world_battle_tests) with its manifest and job states.",
  "type": "object",
  "required": ["schemaVersion", "id", "operator", "type", "state", "manifest", "jobs", "createdAt"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string" },
    "operator": { "type": "string" },
    "type": { "enum": ["readiness", "simulation", "hybrid", "exercise", "cross-border"] },
    "state": { "enum": ["draft", "validated", "queued", "running", "paused", "completed", "partial", "failed", "canceled"] },
    "config": { "$ref": "battle-test-config.schema.json" },
    "manifest": {
      "type": "object",
      "required": ["frameworkVersion", "codeVersion", "geoVersion", "perJob"],
      "additionalProperties": false,
      "properties": {
        "frameworkVersion": { "type": "string" },
        "codeVersion": { "type": "string" },
        "geoVersion": { "type": "string" },
        "perJob": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "sector", "settingsHash", "mode"],
            "additionalProperties": false,
            "properties": {
              "code": { "type": "string", "pattern": "^[a-z]{2}$" },
              "sector": { "type": "string" },
              "settingsHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "runId": { "type": "string" },
              "mode": { "enum": ["local", "sovereign", "cloud"] },
              "modelIds": { "type": "array", "items": { "type": "string" } },
              "corpusFingerprint": {
                "type": "object", "additionalProperties": false,
                "properties": { "chunks": { "type": "integer" }, "latestIngestAt": { "type": ["string", "null"] }, "manifestGenerated": { "type": ["string", "null"] } }
              },
              "startedAt": { "type": "string", "format": "date-time" }
            }
          }
        }
      }
    },
    "jobs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "code", "sector", "state", "attempts"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "code": { "type": "string", "pattern": "^[a-z]{2}$" },
          "sector": { "type": "string" },
          "state": { "enum": ["queued", "leased", "running", "succeeded", "failed", "skipped", "canceled", "interrupted"] },
          "attempts": { "type": "integer", "minimum": 0 },
          "runId": { "type": "string" },
          "failure": { "type": "string" },
          "startedAt": { "type": "string", "format": "date-time" },
          "finishedAt": { "type": "string", "format": "date-time" }
        }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" }
  }
}
