{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/sps/world/world-summary.schema.json",
  "title": "WorldSummary",
  "description": "Read model returned by GET /v1/world/summary. Keys are ISO 3166-1 alpha-2 codes in lower case, as in the countries registry.",
  "type": "object",
  "required": [
    "schemaVersion",
    "frameworkVersion",
    "sector",
    "scope",
    "generatedAt",
    "countries"
  ],
  "additionalProperties": false,
  "$defs": {
    "dimId": {
      "enum": [
        "data_marketplace",
        "generated_content",
        "cross_domain",
        "contextualization",
        "ai_integration",
        "human_interface",
        "strategy_alignment",
        "collaboration",
        "human_impact",
        "ai_policies",
        "ai_inclusion",
        "granular_priorities",
        "digital_infrastructure"
      ]
    },
    "entry": {
      "type": "object",
      "required": [
        "code",
        "registryStatus",
        "sectors",
        "state",
        "runs"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z]{2}$"
        },
        "registryStatus": {
          "enum": [
            "active",
            "planned",
            "unregistered"
          ]
        },
        "sectors": {
          "type": "array",
          "items": {
            "enum": [
              "health",
              "education",
              "telecom",
              "public_services",
              "agriculture"
            ]
          }
        },
        "state": {
          "enum": [
            "not-assessed",
            "no-grounded-data",
            "low-confidence",
            "ok"
          ],
          "description": "Resolved by the display rules of docs/05."
        },
        "composite": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 5
        },
        "band": {
          "type": [
            "string",
            "null"
          ]
        },
        "coverage": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "stale": {
          "type": "boolean"
        },
        "runs": {
          "type": "integer",
          "minimum": 0
        },
        "lastRunAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "corpus": {
          "type": "object",
          "required": [
            "chunks"
          ],
          "additionalProperties": false,
          "properties": {
            "chunks": {
              "type": "integer",
              "minimum": 0
            },
            "manifestPresent": {
              "type": "boolean"
            },
            "criticalPresent": {
              "type": "integer",
              "minimum": 0
            },
            "criticalTotal": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "dims": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/dimId"
          },
          "additionalProperties": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 5
          }
        }
      }
    }
  },
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "frameworkVersion": {
      "type": "string"
    },
    "sector": {
      "enum": [
        "health",
        "education",
        "telecom",
        "public_services",
        "agriculture",
        "all"
      ]
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "countries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "scope": {
      "enum": [
        "mine",
        "shared"
      ],
      "description": "mine = current operator's complete runs; shared = every operator's complete runs, summary fields only."
    }
  }
}