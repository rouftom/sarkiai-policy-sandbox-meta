{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/sps/world/battle-test-config.schema.json",
  "title": "BattleTestConfig",
  "description": "Body of POST /v1/world/battle-tests (and /validate, /dry-run). Settings are stored as sparse overrides; the cascade is type defaults, global, group, country, region.",
  "type": "object",
  "required": [
    "schemaVersion",
    "type",
    "sectors",
    "participants"
  ],
  "additionalProperties": false,
  "$defs": {
    "dimId": {
      "enum": [
        "data_marketplace",
        "generated_content",
        "cross_domain",
        "contextualization",
        "ai_integration",
        "human_interface",
        "strategy_alignment",
        "collaboration",
        "human_impact",
        "ai_policies",
        "ai_inclusion",
        "granular_priorities",
        "digital_infrastructure"
      ]
    },
    "readinessSettings": {
      "type": "object",
      "additionalProperties": false,
      "description": "Subset of the existing ReadinessRunInput (country, domain, globalCountry and batchId are set by the orchestrator).",
      "properties": {
        "dimensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dimId"
          },
          "uniqueItems": true
        },
        "perDimensionK": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "useWeb": {
          "type": "boolean"
        },
        "reasoningEffort": {
          "enum": [
            "minimal",
            "low",
            "medium",
            "high"
          ]
        },
        "models": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "webSearch": {
              "type": "string"
            },
            "evaluate": {
              "type": "string"
            },
            "synthesis": {
              "type": "string"
            }
          }
        },
        "concurrency": {
          "enum": [
            "parallel",
            "sequential",
            "orchestrated"
          ]
        },
        "maxDecisions": {
          "type": "integer",
          "minimum": 1
        },
        "language": {
          "enum": [
            "fr",
            "en"
          ]
        },
        "weights": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/dimId"
          },
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "includeSubnational": {
          "type": "boolean"
        },
        "referenceNamespaces": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "simulationSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scenarioId": {
          "type": "string"
        },
        "agents": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "chunkDelayMs": {
          "type": "integer",
          "minimum": 0
        },
        "model": {
          "type": "string"
        }
      }
    },
    "exerciseSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exerciseId": {
          "type": "string"
        },
        "clockSpeed": {
          "type": "number",
          "minimum": 0.1
        }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "readiness": {
          "$ref": "#/$defs/readinessSettings"
        },
        "simulation": {
          "$ref": "#/$defs/simulationSettings"
        },
        "exercise": {
          "$ref": "#/$defs/exerciseSettings"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1000
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        }
      }
    }
  },
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "type": {
      "enum": [
        "readiness",
        "simulation",
        "hybrid",
        "exercise",
        "cross-border"
      ]
    },
    "title": {
      "type": "string",
      "maxLength": 120
    },
    "sectors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "health",
          "education",
          "telecom",
          "public_services",
          "agriculture"
        ]
      }
    },
    "participants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 60,
      "items": {
        "type": "object",
        "required": [
          "code"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z]{2}$"
          },
          "regionId": {
            "type": "string",
            "pattern": "^[A-Z]{2}-[A-Z0-9]{1,3}$|^X-[A-Z]{2}-[a-z0-9-]+$"
          }
        }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "global": {
          "$ref": "#/$defs/settings"
        },
        "groups": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/settings"
          }
        },
        "countries": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z]{2}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/settings"
          }
        },
        "regions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/settings"
          }
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}