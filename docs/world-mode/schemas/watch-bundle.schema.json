{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/sps/world/watch-bundle.schema.json",
  "title": "WatchBundle",
  "description": "bundle.json at the root of an offline source bundle (.zip) imported through POST /v1/world/watch/import.",
  "type": "object",
  "required": [
    "schemaVersion",
    "country",
    "documents"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "country": {
      "type": "string",
      "pattern": "^[a-z]{2}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "file",
          "title",
          "docType",
          "jurisdiction",
          "sha256",
          "claimedRights"
        ],
        "additionalProperties": false,
        "properties": {
          "file": {
            "type": "string",
            "pattern": "^[^/\\\\]+$"
          },
          "title": {
            "type": "string"
          },
          "authority": {
            "type": "string"
          },
          "docType": {
            "enum": [
              "law",
              "strategy",
              "regulation",
              "policy",
              "treaty",
              "standard",
              "guidance",
              "report"
            ]
          },
          "jurisdiction": {
            "enum": [
              "national",
              "subnational",
              "regional",
              "international"
            ]
          },
          "publishedAt": {
            "type": "string"
          },
          "sourceUrl": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "claimedRights": {
            "enum": [
              "official-text",
              "open-licence",
              "quotation-only",
              "to-confirm"
            ]
          },
          "subdivision": {
            "type": "string",
            "pattern": "^[A-Z]{2}-[A-Z0-9]{1,3}$|^X-[A-Z]{2}-[a-z0-9-]+$"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "jurisdiction": {
                  "const": "subnational"
                }
              },
              "required": [
                "jurisdiction"
              ]
            },
            "then": {
              "required": [
                "subdivision"
              ]
            }
          }
        ]
      }
    }
  }
}