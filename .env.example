# ─────────────────────────────────────────────────────────────────────────────
# SarkiAI Policy Sandbox — Meta edition.
# Copy to `.env` and fill in. NEVER commit `.env`.
#
# Three provider modes (SANDBOX_MODE):
#   local      → Ollama (Muse Glimmer + bge-m3). No data leaves the machine.
#   sovereign  → Muse Glimmer (30B, Apache-2.0) served by Ollama, or a hosted
#                open-weight provider (Baseten / Modal).
#   cloud      → Meta Model API (Muse Spark, SAM 3.1, Muse Voice Transcribe).
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Provider mode ────────────────────────────────────────────────────────────
SANDBOX_MODE=local           # local | sovereign | cloud
RUN_BUDGET_USD=1.50          # hard ceiling per scenario run (USD)
# Output ceiling per generation. Reasoning models think first: muse-spark-1.3
# burns 600–1500 tokens before answering, and the ceiling is not billed.
AGENT_MAX_OUTPUT_TOKENS=4096

# ── Meta Model API (cloud) — OpenAI-compatible, https://api.meta.ai/v1 ───────
# Key: Model API dashboard. Never commit it.
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
# The chat model is chosen in the console from Meta's model list (not an env var).
META_SAM_MODEL=sam-3.1
META_VOICE_MODEL=muse-voice-transcribe-1.0

# ── Sovereign mode — open-weight models ──────────────────────────────────────
# Preferred: Muse Glimmer (30B dense, Apache-2.0) served by Ollama.
# Needs Ollama >= 0.32.7 and ~24 GB VRAM for the Q4_K_M build. `make glimmer`
# pulls the weights, applies deploy/ollama/Modelfile.glimmer and creates the
# `sps-glimmer` tag (then set MUSE_GLIMMER_MODEL=sps-glimmer).
MUSE_GLIMMER_MODEL=muse-glimmer
# Hosted open weights (fallback / bonus prize): Baseten or Modal.
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open-1026
MODAL_ENDPOINT_URL=

# ── WhatsApp Cloud API (institutional focal points) ──────────────────────────
# Called directly by the API; no notification gateway. Business-initiated
# messages must use approved templates (see deploy/whatsapp/templates.md).
WHATSAPP_VERSION=v26.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_RECIPIENT_WAID=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_API_URL=https://graph.facebook.com
# Signs the approval links sent on WhatsApp; decisions are taken in the web app.
APPROVAL_SECRET=change-me-approval-secret
# Canonical console origin, used in every link the API sends (approval button,
# invitation, password reset). Leave empty for a local install: links then point
# at http://localhost:3000. Set it to the address users actually open.
WEB_PUBLIC_URL=
# Other origins the console answers on (LAN name, previous domain, staging
# host), comma-separated. `*.vercel.app` previews are always accepted.
WEB_PUBLIC_URL_ALIASES=
# Escape hatch for an unusual reverse proxy: accept any browser origin. When
# WEB_PUBLIC_URL is empty this is already the default on a self-hosted install.
WEB_ALLOW_ANY_ORIGIN=

# ── Web UI ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_DEFAULT_LOCALE=en   # en | fr (UI is bilingual, English by default)
# Canonical origin baked into absolute metadata (Open Graph, icons). Empty means
# the host's own production URL, then http://localhost:3000. Read at build time.
NEXT_PUBLIC_WEB_URL=
# Extra origins allowed by Server Actions, comma-separated. Same-origin requests
# always pass, so an on-premise install behind a LAN name needs nothing here.
NEXT_PUBLIC_WEB_ORIGINS=

# ── Local models (Ollama) — LLM + embeddings ─────────────────────────────────
# Pull with: `make models` (or: docker compose exec ollama ollama pull <model>)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_PORT=11434
# Muse Glimmer = Meta open weights (30B, multimodal, Apache-2.0); needs ~32 GB of VRAM.
# On a smaller machine, use a lighter model for development, e.g. qwen3.5:9b (6.6 GB).
OLLAMA_MODEL=muse-glimmer

# Local embeddings (Ollama). bge-m3 = 1024-dim, multilingual (FR).
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=64

# Optional local reranker (TEI). Leave empty for RRF-only, or enable the
# `rerank` compose profile and set http://rerank:80.
RERANK_URL=
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_PORT=8080

# ── Vector knowledge base (Qdrant) ───────────────────────────────────────────
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=policy_chunks
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# ── Cloud retrieval — Voyage + MongoDB Atlas Vector Search ───────────────────
# `auto` follows SANDBOX_MODE: cloud => atlas + voyage, else qdrant + bge-m3.
# Cloud mode embeds with Voyage and searches Atlas. Atlas indexes are created
# at API startup in cloud mode only (deploy/mongo/kb.indexes.json).
RETRIEVAL_BACKEND=auto
VOYAGE_API_KEY=
VOYAGE_API_URL=https://api.voyageai.com/v1
VOYAGE_EMBEDDING_MODEL=voyage-4
VOYAGE_RERANK_MODEL=rerank-2
MONGODB_RAG_COLLECTION=kb_chunks
MONGODB_VECTOR_INDEX=sps_vector_index
MONGODB_TEXT_INDEX=sps_text_index
MONGODB_AUTO_INDEXES=true

# ── Operational store (audit + chain-of-thought; NO vectors) ────────────────
MONGODB_URI=mongodb://mongo:27017
MONGODB_DB_NAME=policy_sandbox
MONGO_PORT=27017

# ── Object storage (MinIO, S3-compatible) — assistant image attachments ──────
S3_ENDPOINT=http://minio:9000
S3_BUCKET=sps-attachments
S3_ACCESS_KEY=sps-minio
S3_SECRET_KEY=sps-minio-secret
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── Local transcription (faster-whisper) ─────────────────────────────────────
WHISPER_MODEL=large-v3      # lighter: small / medium / distil-large-v3
WHISPER_DEVICE=cpu          # cuda with a GPU
WHISPER_COMPUTE_TYPE=int8   # float16 on GPU

# ── Chunking ─────────────────────────────────────────────────────────────────
DEFAULT_CHUNK_SIZE=900
DEFAULT_CHUNK_OVERLAP=120

# ── Services ─────────────────────────────────────────────────────────────────
INGESTION_URL=http://ingestion:8000
OCR_URL=http://ocr:8000
TRANSCRIPTION_URL=http://transcription:8000
API_PORT=8000
WEB_PORT=3000
INGESTION_PORT=8001
OCR_PORT=8002
TRANSCRIPTION_PORT=8003

# ── Shared secret between API and Python services ────────────────────────────
SERVICE_API_KEY=change-me-service-key

# ── Audit / CoT trace ────────────────────────────────────────────────────────
AUDIT_ENABLED=true
COT_TRACE_ENABLED=true

# ── Operator accounts + transactional e-mail (Resend) ────────────────────────
# No operator is seeded: the console's /setup screen creates the root account
# and mails a one-time password. Without AUTH_RESEND_KEY that screen refuses to
# create anything (it never falls back to a password on screen).
AUTH_RESEND_KEY=
AUTH_RESEND_EMAIL_FROM=SarkiAI Policy Sandbox <no-reply@example.com>
AUTH_RESEND_EMAIL_REPLY_TO=
# Used to build the sign-in link inside the invitation e-mail (same variable as
# above; set it once for a public host).
WEB_PUBLIC_URL=
# Public self-service sign-up. Defaults to open when SANDBOX_MODE=cloud or a
# MODEL_API_KEY is present, closed otherwise (local / sovereign runs keep a
# single operator). The /login link stays visible when accounts already exist;
# only this flag (or the cloud gate) closes the endpoint.
AUTH_SIGNUP=
# Upper bound on accounts created through the public form (demo only).
AUTH_MAX_OPERATORS=12

# ── Cloudflare Turnstile (optional) ──────────────────────────────────────────
# Human check on the sign-up and password-reset forms. Active in `cloud` and
# `sovereign`; `local` never calls Cloudflare. With no keys the check is off and
# the forms keep working, and an unreachable Cloudflare never blocks a request.
# The site key is public: the API serves it to the console on /v1/auth/captcha.
NEXT_PUBLIC_CLOUDFLARE_TURNSITE_SITE_KEY=
# Canonical secret name. `CLOUDFLARE_TURNSITE_SITE_SECRET` is still read for
# deployments created before the rename.
TURNSTILE_SECRET=
CLOUDFLARE_TURNSITE_SITE_SECRET=
# Hostnames accepted by siteverify, comma-separated. Set it in production: it
# pins which console origin the tokens were minted for. Empty = accept any host
# the widget itself allows.
TURNSTILE_HOSTNAMES=

