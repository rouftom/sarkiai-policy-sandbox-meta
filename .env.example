# ─────────────────────────────────────────────────────────────────────────────
# SarkiAI Policy Sandbox — LOCAL-ONLY (sovereign). No cloud provider.
# Copy to `.env` and fill in. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Local models (Ollama) — LLM + embeddings ─────────────────────────────────
# Pull with: `make models` (or: docker compose exec ollama ollama pull <model>)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_PORT=11434
# qwen3.5:9b = multimodal (text + image), 6.6GB, 256K context.
OLLAMA_MODEL=qwen3.5:9b      # alternatives: qwen2.5:14b (text-only), qwen2.5:7b

# Local embeddings (Ollama). bge-m3 = 1024-dim, multilingual (FR).
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=64

# Optional local reranker (TEI). Leave empty for RRF-only, or enable the
# `rerank` compose profile and set http://rerank:80.
RERANK_URL=
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_PORT=8080

# ── Vector knowledge base (Qdrant) ───────────────────────────────────────────
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=policy_chunks
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# ── Operational store (audit + chain-of-thought; NO vectors) ────────────────
MONGODB_URI=mongodb://mongo:27017
MONGODB_DB_NAME=policy_sandbox
MONGO_PORT=27017

# ── Object storage (MinIO, S3-compatible) — assistant image attachments ──────
S3_ENDPOINT=http://minio:9000
S3_BUCKET=sps-attachments
S3_ACCESS_KEY=sps-minio
S3_SECRET_KEY=sps-minio-secret
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── Local transcription (faster-whisper) ─────────────────────────────────────
WHISPER_MODEL=large-v3      # lighter: small / medium / distil-large-v3
WHISPER_DEVICE=cpu          # cuda with a GPU
WHISPER_COMPUTE_TYPE=int8   # float16 on GPU

# ── Chunking ─────────────────────────────────────────────────────────────────
DEFAULT_CHUNK_SIZE=900
DEFAULT_CHUNK_OVERLAP=120

# ── Services ─────────────────────────────────────────────────────────────────
INGESTION_URL=http://ingestion:8000
OCR_URL=http://ocr:8000
TRANSCRIPTION_URL=http://transcription:8000
API_PORT=8000
WEB_PORT=3000
INGESTION_PORT=8001
OCR_PORT=8002
TRANSCRIPTION_PORT=8003

# ── Shared secret between API and Python services ────────────────────────────
SERVICE_API_KEY=change-me-service-key

# ── Audit / CoT trace ────────────────────────────────────────────────────────
AUDIT_ENABLED=true
COT_TRACE_ENABLED=true
