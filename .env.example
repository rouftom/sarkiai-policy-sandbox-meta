# ─────────────────────────────────────────────────────────────────────────────
# SarkiAI Policy Sandbox — Meta edition.
# Copy to `.env` and fill in. NEVER commit `.env`.
#
# Three provider modes (SANDBOX_MODE):
#   local      → Muse Glimmer served by Ollama. No data leaves the machine.
#   sovereign  → Muse Glimmer (30B, Apache-2.0) served by Ollama, or a hosted
#                open-weight provider (Baseten / Modal).
#   cloud      → Meta Model API (Muse Spark, SAM 3.1, Muse Voice Transcribe).
#
# A local run needs no key at all. Meta Model API, Baseten, Resend and
# Cloudflare Turnstile values are optional and only enable the corresponding
# capability; every feature degrades explicitly when its key is absent.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Provider mode ────────────────────────────────────────────────────────────
SANDBOX_MODE=local           # local | sovereign | cloud
# Alert-only: a run above this ceiling is flagged in the console, never stopped.
RUN_BUDGET_USD=1.50
# Output ceiling per generation. Reasoning models think first: muse-spark-1.3
# burns 600–1500 tokens before answering, and the ceiling is not billed.
AGENT_MAX_OUTPUT_TOKENS=4096

# ── Meta Model API (cloud) — OpenAI-compatible, https://api.meta.ai/v1 ───────
# Key: Model API dashboard. Never commit it.
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
# The chat model is chosen in the console from Meta's model list (not an env var).
META_SAM_MODEL=sam-3.1
META_VOICE_MODEL=muse-voice-transcribe-1.0

# ── Sovereign mode — open-weight models ──────────────────────────────────────
# Preferred: Muse Glimmer (30B dense, Apache-2.0) served by Ollama.
# Needs Ollama >= 0.32.7 and ~24 GB VRAM for the Q4_K_M build. `make glimmer`
# pulls the weights, applies deploy/ollama/Modelfile.glimmer and creates the
# `sps-glimmer` tag (then set MUSE_GLIMMER_MODEL=sps-glimmer).
MUSE_GLIMMER_MODEL=muse-glimmer
# Hosted open weights (fallback / bonus prize): Baseten or Modal.
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open-1026
MODAL_ENDPOINT_URL=

# ── WhatsApp Cloud API (institutional focal points) ──────────────────────────
# Called directly by the API; no notification gateway. Business-initiated
# messages must use approved templates (see deploy/whatsapp/templates.md).
WHATSAPP_VERSION=v26.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_RECIPIENT_WAID=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_API_URL=https://graph.facebook.com
# Signs the approval links sent on WhatsApp; decisions are taken in the web app.
# A cloud deployment on a public origin refuses to start with this public value.
APPROVAL_SECRET=change-me-approval-secret
# Canonical console origin, used in every link the API sends (approval button,
# invitation, password reset). Leave empty for a local install: links then point
# at http://localhost:3000. Set it to the address users actually open.
WEB_PUBLIC_URL=
# Other origins the console answers on (LAN name, previous domain, staging
# host), comma-separated. `*.vercel.app` previews are always accepted.
WEB_PUBLIC_URL_ALIASES=
# Escape hatch for an unusual reverse proxy: accept any browser origin. When
# WEB_PUBLIC_URL is empty this is already the default on a self-hosted install.
WEB_ALLOW_ANY_ORIGIN=

# ── Web UI ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_DEFAULT_LOCALE=en   # en | fr (UI is bilingual, English by default)
# Canonical origin baked into absolute metadata (Open Graph, icons). Empty means
# the host's own production URL, then http://localhost:3000. Read at build time.
NEXT_PUBLIC_WEB_URL=
# Extra origins allowed by Server Actions, comma-separated. Same-origin requests
# always pass, so an on-premise install behind a LAN name needs nothing here.
NEXT_PUBLIC_WEB_ORIGINS=

# ── Local model (Ollama) — Muse Glimmer ──────────────────────────────────────
# Pull with: `make models` (or: docker compose exec ollama ollama pull <model>)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_PORT=11434
# Muse Glimmer = Meta open weights (30B, multimodal, Apache-2.0); needs ~32 GB of VRAM.
OLLAMA_MODEL=muse-glimmer

# ── Corpus search ────────────────────────────────────────────────────────────
# Lexical index driven by the Meta model of the mode (agentic search: plan,
# sub-agents, judge loops, ranking). `auto` follows SANDBOX_MODE: Atlas Search
# in the cloud, a MongoDB text index in local and sovereign installs.
RETRIEVAL_BACKEND=auto
# Default reasoning budget per search: lexical | fast | deep. The assistant
# always searches in `deep`.
RETRIEVAL_DEPTH=fast
MONGODB_RAG_COLLECTION=kb_chunks
MONGODB_TEXT_INDEX=sps_text_index
MONGODB_AUTO_INDEXES=true

# ── Store (corpus, audit log, chain-of-thought) ─────────────────────────────
MONGODB_URI=mongodb://mongo:27017
MONGODB_DB_NAME=policy_sandbox
MONGO_PORT=27017

# ── Object storage (MinIO, S3-compatible) — assistant image attachments ──────
S3_ENDPOINT=http://minio:9000
S3_BUCKET=sps-attachments
S3_ACCESS_KEY=sps-minio
S3_SECRET_KEY=sps-minio-secret
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── Chunking ─────────────────────────────────────────────────────────────────
DEFAULT_CHUNK_SIZE=900
DEFAULT_CHUNK_OVERLAP=120

# ── Services ─────────────────────────────────────────────────────────────────
API_PORT=8000
WEB_PORT=3000

# ── Shared secret between the API and its internal services ──────────────────
SERVICE_API_KEY=change-me-service-key

# ── Audit / CoT trace ────────────────────────────────────────────────────────
AUDIT_ENABLED=true
COT_TRACE_ENABLED=true

# ── Operator accounts + transactional e-mail (Resend, optional) ──────────────
# No account is pre-created: the first visit to /setup creates one.
#   - With AUTH_RESEND_KEY, the temporary password is emailed.
#   - Without it, on a local instance (WEB_PUBLIC_URL unset or a localhost /
#     private-network host), the one-time password is returned once to the
#     setup page, so a judge can start without any e-mail service.
# A public deployment must set AUTH_RESEND_KEY: it never displays the password.
AUTH_RESEND_KEY=
AUTH_RESEND_EMAIL_FROM=SarkiAI Policy Sandbox <no-reply@example.com>
AUTH_RESEND_EMAIL_REPLY_TO=
# Used to build the sign-in link inside the invitation e-mail (same variable as
# above; set it once for a public host).
WEB_PUBLIC_URL=
# Public self-service sign-up. Defaults to open when SANDBOX_MODE=cloud or a
# MODEL_API_KEY is present, closed otherwise (local / sovereign runs keep a
# single operator). The /login link stays visible when accounts already exist;
# only this flag (or the cloud gate) closes the endpoint.
AUTH_SIGNUP=
# Upper bound on accounts created through the public form (demo only).
# The public deployment uses 32 during the judging period.
AUTH_MAX_OPERATORS=12
# Only administrators may change shared state: the legal corpus, the country
# registry, the address book and outbound WhatsApp / e-mail messages.

# Vercel project accepted by CORS (production and preview hosts), and optionally
# the team slug a preview host must end with. Other *.vercel.app hosts are refused.
VERCEL_PROJECT_NAME=sarkiai-policy-sandbox-meta
VERCEL_TEAM_SLUG=

# Host address the internal services (Mongo, Ollama, MinIO, MCP servers)
# publish their ports on. 127.0.0.1 keeps them off the network; set 0.0.0.0 only
# behind a firewall, when another machine must reach them.
SERVICES_BIND_ADDRESS=127.0.0.1

# Console Content-Security-Policy (img-src, frame-src): extra origins, and a
# report-only switch to observe violations without blocking.
NEXT_PUBLIC_CSP_IMG_SOURCES=
NEXT_PUBLIC_CSP_FRAME_SOURCES=
NEXT_PUBLIC_CSP_REPORT_ONLY=

# ── Cloudflare Turnstile (optional) ──────────────────────────────────────────
# Human check on the sign-up and password-reset forms. Active in `cloud` and
# `sovereign`; `local` never calls Cloudflare. With no keys the check is off and
# the forms keep working, and an unreachable Cloudflare never blocks a request.
# The public site key is read by the API, which serves it on /v1/auth/captcha.
# The browser fetches it from there at runtime, so the web build carries no
# Turnstile variable of its own. The historical name below is still read, server
# side; keep it on deployments that already set it.
NEXT_PUBLIC_CLOUDFLARE_TURNSITE_SITE_KEY=
# Canonical secret name. `CLOUDFLARE_TURNSITE_SITE_SECRET` is still read for
# deployments created before the rename.
TURNSTILE_SECRET=
CLOUDFLARE_TURNSITE_SITE_SECRET=
# Hostnames accepted by siteverify, comma-separated. Set it in production: it
# pins which console origin the tokens were minted for. Empty = accept any host
# the widget itself allows.
TURNSTILE_HOSTNAMES=

# ── Request budgets (rate limiting) ──────────────────────────────────────────
# Per-caller counters, in process. The whole authenticated API shares one
# window; the routes that spend model credits get a tighter one. 429 responses
# carry Retry-After and RateLimit-* headers. Set RATE_LIMIT_ENABLED=false to
# lift both (single-instance demo, or a workflow that legitimately bursts).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=240
RATE_LIMIT_EXPENSIVE_MAX=20

# ── Backpressure (in-flight model work) ──────────────────────────────────────
# A readiness series runs one stream per sector in parallel, so the per-operator
# default sits above five; past the cap the API answers 429 immediately instead
# of queueing. The global cap protects the single instance. 0 disables a cap.
AI_CONCURRENCY_PER_OPERATOR=8
AI_CONCURRENCY_GLOBAL=16
# Dimensions one readiness run evaluates at once (was unbounded: 13 per sector).
READINESS_DIMENSION_CONCURRENCY=4

# ── MongoDB pools ────────────────────────────────────────────────────────────
# Several services open their own client (auth, audit, reports, retrieval and
# the per-feature stores). Each one is bounded so a slow cluster queues at most
# this many connections, for this long, instead of holding every request.
MONGODB_MAX_POOL_SIZE=10
MONGODB_WAIT_QUEUE_TIMEOUT_MS=5000

