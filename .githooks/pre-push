#!/bin/sh
# Block direct pushes to the long-lived branches.
#
# Protected here: main (production), develop (integration) and
# meta-hackathon (submission mirror). Work must land through a pull request.
#
# This hook is a guard-rail for the local clone. GitHub branch protection is
# the authoritative lock; `gh pr merge` runs server-side and is unaffected.
#
# Bootstrap only: ALLOW_PROTECTED_BRANCH_PUSH=1 git push origin <branch>

set -eu

protected_branches="main develop meta-hackathon"

if [ "${ALLOW_PROTECTED_BRANCH_PUSH:-0}" = "1" ]; then
  echo "pre-push: ALLOW_PROTECTED_BRANCH_PUSH=1 — protected-branch guard bypassed." >&2
  exit 0
fi

status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${remote_ref:-}" ] || continue

  case "$remote_ref" in
    refs/heads/*) branch=${remote_ref#refs/heads/} ;;
    *) continue ;;
  esac

  for protected in $protected_branches; do
    if [ "$branch" = "$protected" ]; then
      if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
        action="delete"
      else
        action="update"
      fi
      echo "" >&2
      echo "pre-push: refusing to $action protected branch '$branch'." >&2
      echo "  Every change — documentation included — goes through a PR:" >&2
      echo "    git switch -c feat/<scope>" >&2
      echo "    git push -u origin feat/<scope>" >&2
      echo "    gh pr create --base develop" >&2
      echo "  Procedure: docs/agent-workflow.md" >&2
      echo "  Bootstrap only: ALLOW_PROTECTED_BRANCH_PUSH=1 git push origin $branch" >&2
      status=1
      break
    fi
  done
done

exit "$status"
